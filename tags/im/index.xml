        <title>Fcitx5输入法中文标点设定</title>
        <link>https://localfreedom.pages.dev/p/fcitx5%E8%BE%93%E5%85%A5%E6%B3%95%E4%B8%AD%E6%96%87%E6%A0%87%E7%82%B9%E8%AE%BE%E5%AE%9A/</link>
